{
  "version": 2,
  "installCommand": "cd memora-frontend && npm install --include=dev",
  "buildCommand": "cd memora-frontend && npx vite build",
  "outputDirectory": "memora-frontend/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
